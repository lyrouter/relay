# Relay S1 · local development.
# Three roles, on purpose (design §2.4). See scripts/bootstrap_db.sql.
RELAY_PG_HOST=127.0.0.1
RELAY_PG_PORT=5433
RELAY_PG_DATABASE=relay_dev

RELAY_OWNER_USER=relay_owner
RELAY_OWNER_PASSWORD=relay_owner
RELAY_APP_USER=relay_app
RELAY_APP_PASSWORD=relay_app
RELAY_SYSTEM_USER=relay_system
RELAY_SYSTEM_PASSWORD=relay_system

# LOG-5 · attachments. The S1 carrier is self-hosted MinIO (F-4); its adapter is
# not written yet, so development and tests use the filesystem store below.
# RELAY_BLOB_SIGNING_KEY must be set in any deployment — the default is
# deliberately obvious so an unset value shows up in a config review.
RELAY_BLOB_ROOT=./var/blobs
RELAY_BLOB_SIGNING_KEY=dev-only-unsafe-signing-key
