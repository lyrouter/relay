# Relay S1 · local development.
# Three roles, on purpose (design §2.4). See scripts/bootstrap_db.sql.
RELAY_PG_HOST=127.0.0.1
RELAY_PG_PORT=5433
RELAY_PG_DATABASE=relay_dev

RELAY_OWNER_USER=relay_owner
RELAY_OWNER_PASSWORD=relay_owner
RELAY_APP_USER=relay_app
RELAY_APP_PASSWORD=relay_app
RELAY_SYSTEM_USER=relay_system
RELAY_SYSTEM_PASSWORD=relay_system

# LOG-5 · attachments. Two carriers, one key layout (S-25), so switching moves no
# object and rewrites no stored blob_key.
#
#   filesystem — development and tests. Serves its own bytes from /blobs/{key}.
#   minio      — the deployed carrier (F-4). The browser fetches the object
#                directly, and /blobs/{key} is then **not mounted at all**.
RELAY_BLOB_CARRIER=filesystem
RELAY_BLOB_ROOT=./var/blobs

# The MinIO/S3 settings, ignored while the carrier is `filesystem`.
#
# ⚠️ RELAY_MINIO_PUBLIC_ENDPOINT is the one people get wrong. A presigned URL is
# signed *for a host*; sign it for the internal endpoint and users see broken
# images with **nothing in the application log**, because the browser talks to the
# object store directly and never comes back to us. Leave it empty only when the
# internal address really is browser-reachable — the app warns at startup either
# way. `scripts/check_blob_store.py` checks this, the addressing style, the clock
# skew and whether the bucket is private, in one round trip.
# RELAY_MINIO_ENDPOINT=http://minio.internal:9000
# RELAY_MINIO_PUBLIC_ENDPOINT=https://files.relay.internal
# RELAY_MINIO_ACCESS_KEY=
# RELAY_MINIO_SECRET_KEY=
# RELAY_MINIO_BUCKET=relay-attachments
# RELAY_MINIO_REGION=us-east-1
# MinIO addresses buckets path-style; only a real S3 needs this turned off.
# RELAY_MINIO_PATH_STYLE=true

# Signs the 5-minute attachment download links (S-11). The default below is
# deliberately obvious so that an unset value shows up in a config review rather
# than hiding behind a working link. **Generate a real one per environment:**
#
#   openssl rand -hex 32
#   # or, without openssl:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 32 bytes of hex. Keep it out of version control, treat it like a password, and
# do not reuse it between environments — a staging key that works in production
# means every staging link works in production. Rotating it invalidates every
# link that has already been handed out, which is 5 minutes of breakage and no
# data loss, so rotate freely if it leaks.
RELAY_BLOB_SIGNING_KEY=dev-only-unsafe-signing-key

# API-4 · the master key every webhook endpoint's signing secret is derived from.
# The database stores no signing material at all, so a dump cannot forge our
# signatures — the price is that **changing this breaks every consumer at once**
# (their stored secret stops matching what we send). Set it once per environment
# with `openssl rand -hex 32`; to retire one endpoint's secret, rotate that
# endpoint (POST /api/v1/webhooks/{id}/secret) rather than touching this.
RELAY_WEBHOOK_SIGNING_KEY=dev-only-unsafe-webhook-key

# WEB · the session cookie and the CSRF origin allowlist.
#
# The cookie is Secure by default. A browser silently drops a Secure cookie on
# http://, so local development over http has to turn it off — and production
# must not.
RELAY_SESSION_COOKIE_SECURE=false
# State-changing requests must carry a recognised Origin. Empty means "just the
# public base URL's origin", which is right in production and wrong for a Vite
# dev server on another port. Comma-separated.
RELAY_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Addresses of proxies whose X-Forwarded-For may be believed. Empty = believe
# nobody, so the client address is the peer address. Signup and login throttles
# are per IP; a header trusted by default lets one caller spend everybody else's
# attempts.
RELAY_TRUSTED_PROXIES=

# AC-1 / AC-2 · transactional mail. Empty host means messages are recorded and
# not sent, which means **nobody can finish signing up** (email verification).
# Set this before the first person registers.
# RELAY_SMTP_HOST=smtp.internal
# RELAY_SMTP_PORT=587
# RELAY_SMTP_USERNAME=relay
# RELAY_SMTP_PASSWORD=
# RELAY_MAIL_SENDER=relay@your-domain
